{
  "extends": ["next/core-web-vitals", "prettier"],
  "env": {
    "es2022": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "alert",
        "message": "Use toast from sonner."
      }
    ],
    "no-undef": "error"
  }
}
